#version 450

/*
 * Fills `count` floats in an external buffer with i * 0.01.
 * Buffer reached via buffer device address (no descriptor binding).
 */

#extension GL_EXT_buffer_reference : enable

layout(buffer_reference, std430) writeonly buffer FloatBuffer {
    float data[];
};

layout(push_constant) uniform PC {
    FloatBuffer out_buf;
    uint        count;
} pc;

layout(local_size_x = 64) in;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) return;
    pc.out_buf.data[i] = float(i) * 0.01;
}
