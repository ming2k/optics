# Examples — headless only. Windowed demos live in examples/iris/ since
# lens itself has no window/event-loop APIs.

executable('headless_demo', 'headless_demo.c',
  dependencies        : [lens_dep, m_dep],
  include_directories : lens_inc,
)

executable('a11y_tree_demo', 'a11y_tree_demo.c',
  dependencies        : [lens_dep, m_dep],
  include_directories : lens_inc,
)

executable('state_demo', 'state_demo.c',
  dependencies        : [lens_dep, m_dep],
  include_directories : lens_inc,
)
