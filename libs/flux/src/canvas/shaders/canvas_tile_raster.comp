#version 450
#extension GL_EXT_buffer_reference : require

/*
 * Modern GPU Tile-Compute Coverage Rasterizer (ADR-0120 Phase B).
 *
 * Liang-Barsky pixel box analytic area integration entirely on the GPU.
 * Consumes segment SSBO + 16x16 coarse tile metadata + backdrop winding.
 * Eliminates MSAA attachments, eliminates stencil attachments, satisfies INV-COV-02.
 */

struct GpuSegment {
    float x0, y0;
    float x1, y1;
};

struct GpuTileDesc {
    uint segment_offset;
    uint segment_count;
    int backdrop_winding;
    uint pad;
};

layout(buffer_reference, std430) readonly buffer SegmentsBuf {
    GpuSegment segs[];
};

layout(buffer_reference, std430) readonly buffer TilesBuf {
    GpuTileDesc tiles[];
};

layout(buffer_reference, std430) readonly buffer IndicesBuf {
    uint indices[];
};

layout(buffer_reference, std430) writeonly buffer CoverageBuf {
    float data[];
};

layout(push_constant) uniform PushConstants {
    SegmentsBuf seg_buf;
    TilesBuf tile_buf;
    IndicesBuf idx_buf;
    CoverageBuf cov_buf;
    uint tiles_x;
    uint tiles_y;
    uint width;
    uint height;
    uint fill_rule; /* 0 = NonZero, 1 = EvenOdd */
    float ox;
    float oy;
}
pc;

layout(local_size_x = 16, local_size_y = 16) in;

bool clip_test(float p, float q, inout float t0, inout float t1) {
    if (p == 0.0) {
        if (q < 0.0)
            return false;
    } else {
        float r = q / p;
        if (p < 0.0) {
            if (r > t1)
                return false;
            if (r > t0)
                t0 = r;
        } else {
            if (r < t0)
                return false;
            if (r < t1)
                t1 = r;
        }
    }
    return true;
}

void main() {
    uint tx = gl_WorkGroupID.x;
    uint ty = gl_WorkGroupID.y;
    if (tx >= pc.tiles_x || ty >= pc.tiles_y)
        return;

    uint tidx = ty * pc.tiles_x + tx;
    GpuTileDesc td = pc.tile_buf.tiles[tidx];

    uint lx = gl_LocalInvocationID.x;
    uint ly = gl_LocalInvocationID.y;
    uint gx = tx * 16u + lx;
    uint gy = ty * 16u + ly;
    if (gx >= pc.width || gy >= pc.height)
        return;

    uint out_idx = gy * pc.width + gx;

    // Fast-path: Solid interior or empty exterior tile
    if (td.segment_count == 0u) {
        int w = td.backdrop_winding;
        bool inside = (pc.fill_rule == 1u) ? ((w & 1) != 0) : (w != 0);
        pc.cov_buf.data[out_idx] = inside ? 1.0 : 0.0;
        return;
    }

    float px_left = float(gx);
    float px_right = px_left + 1.0;
    float px_top = float(gy);
    float px_bottom = px_top + 1.0;

    float winding = float(td.backdrop_winding);
    float area = 0.0;

    for (uint k = 0u; k < td.segment_count; ++k) {
        uint s_idx = pc.idx_buf.indices[td.segment_offset + k];
        GpuSegment s = pc.seg_buf.segs[s_idx];

        float x0 = s.x0 - pc.ox;
        float y0 = s.y0 - pc.oy;
        float x1 = s.x1 - pc.ox;
        float y1 = s.y1 - pc.oy;

        if (y0 == y1)
            continue;

        float ymin = min(y0, y1);
        float ymax = max(y0, y1);
        if (ymax <= px_top || ymin >= px_bottom)
            continue;

        // Clip to pixel horizontal row [px_top, px_bottom]
        float row_t0 = clamp((px_top - y0) / (y1 - y0), 0.0, 1.0);
        float row_t1 = clamp((px_bottom - y0) / (y1 - y0), 0.0, 1.0);
        float ry0 = mix(y0, y1, row_t0);
        float ry1 = mix(y0, y1, row_t1);
        float rx0 = mix(x0, x1, row_t0);
        float rx1 = mix(x0, x1, row_t1);

        float dy = ry1 - ry0;
        if (abs(dy) <= 1e-7)
            continue;

        // Check if entirely to the right
        float row_min_x = min(rx0, rx1);
        float row_max_x = max(rx0, rx1);

        if (row_min_x >= px_right) {
            winding += dy;
            continue;
        }
        if (row_max_x <= px_left) {
            continue;
        }

        // Liang-Barsky parametric clipping to [px_left, px_right] x [px_top, px_bottom]
        float dx = x1 - x0;
        float full_dy = y1 - y0;
        float t_in = 0.0;
        float t_out = 1.0;

        if (clip_test(-dx, x0 - px_left, t_in, t_out) &&
            clip_test(dx, px_right - x0, t_in, t_out) &&
            clip_test(-full_dy, y0 - px_top, t_in, t_out) &&
            clip_test(full_dy, px_bottom - y0, t_in, t_out)) {

            float cx0 = mix(x0, x1, t_in);
            float cy0 = mix(y0, y1, t_in);
            float cx1 = mix(x0, x1, t_out);
            float cy1 = mix(y0, y1, t_out);

            float local_dy = cy1 - cy0;
            float u0 = cx0 - px_left;
            float u1 = cx1 - px_left;

            // Trapezoid area to right of line inside pixel
            area += local_dy * (1.0 - 0.5 * (u0 + u1));

            // Plus horizontal span of portion that exited through right edge
            if (full_dy > 0.0) {
                // Descending: portion below pixel or after exiting right
                float y_exit = mix(y0, y1, t_out);
                if (cx1 >= px_right - 1e-5 && ry1 > y_exit)
                    winding += (ry1 - y_exit);
                float y_enter = mix(y0, y1, t_in);
                if (cx0 >= px_right - 1e-5 && y_enter > ry0)
                    winding += (y_enter - ry0);
            } else {
                // Ascending
                float y_exit = mix(y0, y1, t_out);
                if (cx1 >= px_right - 1e-5 && ry1 < y_exit)
                    winding += (ry1 - y_exit);
                float y_enter = mix(y0, y1, t_in);
                if (cx0 >= px_right - 1e-5 && y_enter < ry0)
                    winding += (y_enter - ry0);
            }
        } else {
            // Segment did not enter pixel box directly, check if it passed to the right within row
            if (0.5 * (rx0 + rx1) >= px_right)
                winding += dy;
        }
    }

    float total_coverage = abs(winding + area);
    if (pc.fill_rule == 1u) {
        total_coverage = mod(total_coverage, 2.0);
        if (total_coverage > 1.0)
            total_coverage = 2.0 - total_coverage;
    }

    pc.cov_buf.data[out_idx] = clamp(total_coverage, 0.0, 1.0);
}
