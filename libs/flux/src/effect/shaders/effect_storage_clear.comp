#version 450
#extension GL_EXT_nonuniform_qualifier : require

/* Region-limited transparent clear for persistent effect outputs. The host
 * dispatches one invocation rectangle per disjoint previous/current footprint
 * before any material shader runs. */
layout(set = 0, binding = 1, rgba8) uniform image2D u_storage[];

layout(push_constant) uniform PC {
    uint output_handle;
    uint width;
    uint height;
    uint origin_x;
    uint origin_y;
    uint region_width;
    uint region_height;
} pc;

layout(local_size_x = 16, local_size_y = 16) in;

void main()
{
    uvec2 local = gl_GlobalInvocationID.xy;
    if (local.x >= pc.region_width || local.y >= pc.region_height) return;
    uvec2 pixel = local + uvec2(pc.origin_x, pc.origin_y);
    if (pixel.x >= pc.width || pixel.y >= pc.height) return;
    imageStore(u_storage[nonuniformEXT(pc.output_handle & 0x0FFFFFFFu)], ivec2(pixel), vec4(0.0));
}
