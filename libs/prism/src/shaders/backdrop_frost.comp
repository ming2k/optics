#version 450

#extension GL_GOOGLE_include_directive : require

#include "flux_sdf.glsl"
#extension GL_EXT_nonuniform_qualifier : require

/*
 * Base-material pass of the layered backdrop compositor
 * (prism/backdrop_layer.h).
 *
 * Two modes, both dispatched per merged footprint region:
 *
 *   BACKDROP_FROST_MODE_BASE
 *     Resolve the opaque background for the region: the sharp capture,
 *     alpha 1. This is the plate the material presents outside every
 *     frost rect, and the surface the optical lens above refracts when a
 *     bend tap lands between plates. It runs exactly once per region,
 *     before any plate.
 *
 *   BACKDROP_FROST_MODE_PLATE
 *     Composite one base-material plate over whatever is already there:
 *     the (optionally tinted) blurred backdrop, source-over, gated by the
 *     analytic rounded-rect coverage. Pixels outside the plate's coverage
 *     are left untouched, so plates stack in array order and a later
 *     plate never erases an earlier one outside its own silhouette.
 *
 * Before this split the pass wrote an opaque pixel for every dispatched
 * pixel regardless of coverage, so the *last* plate in the array painted
 * the sharp backdrop over every earlier plate inside the shared dispatch
 * region — two overlapping plates could not coexist, and a plate anywhere
 * in the array could be punched out by another one's rectangular
 * footprint. Writing only inside coverage makes the layer order the
 * header documents (`base materials paint before every glass group`) hold
 * per pixel as well as per pass.
 *
 * Storage layout (rgba8 / rgba16f) follows the input class, exactly like
 * the other prism materials.
 */

layout(set = 0, binding = 0) uniform texture2D u_sampled[];
#ifdef PRISM_STORAGE_RGBA16F
layout(set = 0, binding = 1, rgba16f) uniform image2D u_storage[];
#else
layout(set = 0, binding = 1, rgba8) uniform image2D u_storage[];
#endif
layout(set = 0, binding = 2) uniform sampler u_samplers[];

#define BACKDROP_FROST_MODE_BASE  0u
#define BACKDROP_FROST_MODE_PLATE 1u

layout(push_constant) uniform PC {
    uint input_handle; /* sharp capture: the opaque base under the plate */
    uint blurred_handle;
    uint sampler_handle;
    uint output_handle;
    uint width;
    uint height;
    uint origin_x;
    uint origin_y;
    vec4 bounds;       /* plate rect (x, y, w, h), capture-image pixels */
    float corner_radius;
    float opacity;     /* plate opacity [0, 1]; blends plate vs what is under it */
    uint tint_color;   /* 0xRRGGBB wash blended into the plate */
    float tint_strength; /* [0, 1]; 0 keeps the blurred backdrop */
    uint region_width;
    uint region_height;
    uint mode;         /* BACKDROP_FROST_MODE_* */
    uint reserved;
    float slab_origin_x; /* this slab's origin in capture space */
    float slab_origin_y;
    float capture_width;
    float capture_height;
} pc;

layout(local_size_x = 16, local_size_y = 16) in;

/* Convention adapter over the single field definition in flux_sdf.glsl
 * (ADR-0118): `bounds` is (x, y, w, h), and the non-zero half-extent floor
 * keeps a degenerate group finite. The field itself is not defined here. */
float rounded_rect_sdf(vec2 p, vec4 bounds, float requested_radius)
{
    vec2 half_extent = max(bounds.zw * 0.5, vec2(0.001));
    vec2 centre = bounds.xy + half_extent;
    return flux_sdf_round_rect(p - centre, half_extent, requested_radius);
}

vec3 unpack_rgb(uint c)
{
    return vec3(
        float((c >> 16u) & 0xFFu) / 255.0,
        float((c >> 8u) & 0xFFu) / 255.0,
        float(c & 0xFFu) / 255.0
    );
}

vec4 sample_rgb(uint handle, vec2 uv)
{
    return texture(
        sampler2D(
            u_sampled[nonuniformEXT(handle & 0x0FFFFFFFu)],
            u_samplers[nonuniformEXT(pc.sampler_handle & 0x0FFFFFFFu)]
        ),
        clamp(uv, vec2(0.0), vec2(1.0))
    );
}

void main()
{
    uvec2 local = gl_GlobalInvocationID.xy;
    if (local.x >= pc.region_width || local.y >= pc.region_height) return;

    uvec2 pixel = local + uvec2(pc.origin_x, pc.origin_y);
    if (pixel.x >= pc.width || pixel.y >= pc.height) return;

    /* The slab is sized to the layer's footprints, so output coordinate 0 is
     * capture coordinate slab_origin (capture = output + slab_origin) and the
     * sampling UV is against the capture's extent. */
    vec2 p = vec2(pixel) + vec2(0.5) + vec2(pc.slab_origin_x, pc.slab_origin_y);
    vec2 uv = p / max(vec2(pc.capture_width, pc.capture_height), vec2(1.0));

    int handle = int(pc.output_handle & 0x0FFFFFFFu);


    if (pc.mode == BACKDROP_FROST_MODE_BASE) {
        /* The region's background: the sharp capture, opaque. This is what
         * makes the layer a valid lens input — a lens may tap anywhere its
         * bend reaches, including between and outside plates, and must read
         * a true background colour rather than a premultiplied fragment or
         * a cleared hole. */
        imageStore(u_storage[handle], ivec2(pixel), vec4(sample_rgb(pc.input_handle, uv).rgb, 1.0));
        return;
    }

    float coverage = clamp(0.5 - rounded_rect_sdf(p, pc.bounds, pc.corner_radius), 0.0, 1.0) *
                     clamp(pc.opacity, 0.0, 1.0);
    /* Outside this plate's silhouette: leave the pixels already written by
     * the base pass and by earlier plates alone. */
    if (coverage <= 0.0) return;

    /* Caller tint: a wash composited INTO the plate (luminance-opposing
     * veils, scheme-adaptive scrims) so the glass above refracts the washed
     * plate rather than being painted over by a chrome-layer wash. Applied
     * before the coverage mix so the tint never widens the silhouette. */
    vec3 body = mix(sample_rgb(pc.blurred_handle, uv).rgb, unpack_rgb(pc.tint_color),
                    clamp(pc.tint_strength, 0.0, 1.0));

    /* Source-over into the persistent layer. `coverage` is the plate's own
     * alpha, so a partial-coverage plate blends with the background it sits
     * on instead of replacing it — and, at a silhouette edge, with the
     * plate beneath it. */
    vec4 destination = imageLoad(u_storage[handle], ivec2(pixel));
    vec4 source = vec4(body * coverage, coverage);
    imageStore(u_storage[handle], ivec2(pixel), source + destination * (1.0 - coverage));
}
