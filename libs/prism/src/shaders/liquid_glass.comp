#version 450
#extension GL_EXT_nonuniform_qualifier : require

/*
 * Analytic liquid-glass compositor — convex-lens model.
 *
 * The body is treated as a thin lens slab: optically flat in the interior
 * (backdrop passes through undistorted) with a curved rim band of
 * `edge_width` px whose slope follows a clamped spherical-cap profile.
 * The same rounded-rectangle SDF drives coverage, the rim parameterisation
 * and the refraction normal, so no layer can disagree at a corner. Two
 * SDFs can be smoothly unioned into one body for liquid/spring merges.
 *
 * Layer stack, evaluated per pixel inside the analytic coverage:
 *   1. LENSING — refraction displaces the sharp backdrop inward along the
 *      rim normal (convex-lens magnification), with per-channel bend for
 *      chromatic dispersion confined to the rim band.
 *   2. SCATTER — a small frost mix, growing slightly through the rim band.
 *   3. ADAPTIVE TINT — opposes backdrop luminance: pearl lift over dark
 *      content, smoke dim over bright content (legibility layer).
 *   4. LIGHT — a thin directional key line hugging the silhouette on the
 *      light-facing side, a soft sheen across the rim, a shadow-side dark
 *      line opposite the key, and a faint transmitted-light trough inside
 *      the bottom rim. Nothing here is a broad additive wash: the rim
 *      reads as sculpted light, not as a white halo.
 */

layout(set = 0, binding = 0) uniform texture2D u_sampled[];
/* Storage qualifier matches the output format (ADR-0069): rgba16f for
 * working-space (16F) inputs, rgba8 otherwise. Compiled twice, see meson. */
#ifdef PRISM_STORAGE_RGBA16F
layout(set = 0, binding = 1, rgba16f) uniform image2D u_storage[];
#else
layout(set = 0, binding = 1, rgba8) uniform image2D u_storage[];
#endif
layout(set = 0, binding = 2) uniform sampler u_samplers[];

layout(push_constant) uniform PC {
    uint input_handle;
    uint blurred_handle;
    uint sampler_handle;
    uint output_handle;
    uint width;
    uint height;
    uint origin_x;
    uint origin_y;
    vec4 shape0;
    vec4 shape1;
    vec4 focus_shape;
    float radius0;
    float radius1;
    float focus_radius;
    float blend_radius;
    float opacity;
    float refraction;
    float chromatic_aberration;
    float saturation;
    float brightness;
    float edge_width;
    float rim_light;
    float shadow_alpha;
    uint light_dir;
    uint group_extent;
    uint tint_color_shape_count;
    uint shadow_params;
    uint size_params;
    uint strength_params;
    uint focus_curvature;
    uint tone_params;
} pc;

layout(local_size_x = 16, local_size_y = 16) in;

/* Packed push slots: 24-bit 0xRRGGBB tint with shape_count in the top
 * byte, and half2x16 packed parameters. */
uint tint_color()
{
    return pc.tint_color_shape_count & 0x00FFFFFFu;
}

uint shape_count()
{
    return pc.tint_color_shape_count >> 24;
}

vec2 light_direction()
{
    return unpackHalf2x16(pc.light_dir);
}

uvec2 group_extent()
{
    return uvec2(pc.group_extent & 0xFFFFu, pc.group_extent >> 16);
}

vec2 shadow_params()
{
    return unpackHalf2x16(pc.shadow_params);
}

vec2 size_params()
{
    return unpackHalf2x16(pc.size_params);
}

vec2 strength_params()
{
    return unpackHalf2x16(pc.strength_params);
}

vec2 focus_curvature()
{
    return unpackHalf2x16(pc.focus_curvature);
}

vec2 tone_params()
{
    return unpackHalf2x16(pc.tone_params);
}

vec4 sample_image(uint handle, vec2 uv)
{
    return texture(
        sampler2D(
            u_sampled[nonuniformEXT(handle & 0x0FFFFFFFu)],
            u_samplers[nonuniformEXT(pc.sampler_handle & 0x0FFFFFFFu)]
        ),
        clamp(uv, vec2(0.0), vec2(1.0))
    );
}

/* Groups share one persistent premultiplied output. Preserve material already
 * written by lower groups when a later body's translucent shadow or AA fringe
 * reaches it. The dispatches are ordered by storage read/write barriers. */
void store_source_over(uvec2 pixel, vec4 source)
{
    vec4 destination = imageLoad(
        u_storage[nonuniformEXT(pc.output_handle & 0x0FFFFFFFu)], ivec2(pixel)
    );
    imageStore(
        u_storage[nonuniformEXT(pc.output_handle & 0x0FFFFFFFu)],
        ivec2(pixel),
        source + destination * (1.0 - source.a)
    );
}

float squircle_sdf(vec2 p, vec4 bounds, float requested_radius, float curvature)
{
    vec2 half_extent = max(bounds.zw * 0.5, vec2(0.001));
    vec2 centre = bounds.xy + half_extent;
    float radius = clamp(requested_radius, 0.0, min(half_extent.x, half_extent.y));
    vec2 q = abs(p - centre) - half_extent + radius;
    vec2 q_pos = max(q, vec2(0.0));
    
    // Standard Euclidean L2 distance
    float d_l2 = length(q_pos) + min(max(q.x, q.y), 0.0) - radius;
    
    // G2 Superellipse (p = 4 norm) for continuous curvature
    float d_g2 = pow(pow(q_pos.x, 4.0) + pow(q_pos.y, 4.0), 0.25) + min(max(q.x, q.y), 0.0) - radius;
    
    return mix(d_l2, d_g2, clamp(curvature, 0.0, 1.0));
}

float smooth_union(float a, float b, float radius)
{
    if (radius <= 0.001) return min(a, b);
    float h = clamp(0.5 + 0.5 * (b - a) / radius, 0.0, 1.0);
    return mix(b, a, h) - radius * h * (1.0 - h);
}

float glass_sdf(vec2 p)
{
    float cur = focus_curvature().y;
    float d = squircle_sdf(p, pc.shape0, pc.radius0, cur);
    if (shape_count() > 1u) {
        d = smooth_union(d, squircle_sdf(p, pc.shape1, pc.radius1, cur), pc.blend_radius);
    }
    return d;
}

float focus_field(vec2 p)
{
    float f_strength = focus_curvature().x;
    if (f_strength <= 0.0) return 0.0;
    float cur = focus_curvature().y;
    float d = squircle_sdf(p, pc.focus_shape, pc.focus_radius, cur);
    float small_side = min(pc.focus_shape.z, pc.focus_shape.w);
    float feather = clamp(small_side * 0.08, 6.0, 14.0);
    return (1.0 - smoothstep(-feather, feather, d)) * clamp(f_strength, 0.0, 1.0);
}

vec3 adjust_saturation(vec3 colour, float saturation)
{
    float luminance = dot(colour, vec3(0.2126, 0.7152, 0.0722));
    return mix(vec3(luminance), colour, saturation);
}

void main()
{
    uvec2 local = gl_GlobalInvocationID.xy;
    uvec2 g_extent = group_extent();
    if (local.x >= g_extent.x || local.y >= g_extent.y) return;
    uvec2 pixel = local + uvec2(pc.origin_x, pc.origin_y);
    if (pixel.x >= pc.width || pixel.y >= pc.height) return;

    vec2 p = vec2(pixel) + 0.5;
    float d = glass_sdf(p);
    float focus = focus_field(p);
    /* One physical pixel of analytic antialiasing; coverage is also the
     * body's output alpha, preventing blur from leaking beyond corners. */
    float coverage = 1.0 - smoothstep(-0.75, 0.75, d);

    /* Drop shadow: the same SDF shifted down by the light offset, with a
     * soft falloff. It grounds the body and is what separates the glass
     * from uniform bright content. Fades with the body's opacity. */
    float body_min = min(pc.shape0.z, pc.shape0.w);
    vec2 size_ref_min = size_params();
    float size_scale = 1.0;
    if (size_ref_min.x > 0.0) {
        size_scale = clamp(body_min / size_ref_min.x, size_ref_min.y, 1.0);
    }
    
    vec2 shadow_p = shadow_params();
    float shadow_blur = shadow_p.x;
    float shadow_offset_y = shadow_p.y;
    float shadow = 0.0;
    if (pc.shadow_alpha > 0.0) {
        float sd = glass_sdf(p - vec2(0.0, shadow_offset_y));
        shadow = (1.0 - smoothstep(0.0, shadow_blur * 2.0, max(sd, 0.0))) * pc.shadow_alpha;
    }
    shadow *= clamp(pc.opacity, 0.0, 1.0);
    if (coverage <= 0.0) {
        if (shadow <= 0.002) return;
        store_source_over(pixel, vec4(0.0, 0.0, 0.0, shadow));
        return;
    }

    /* Outward rim normal from the SDF gradient. Wide taps keep the normal
     * stable through smooth-union necks. */
    float dx = glass_sdf(p + vec2(1.5, 0.0)) - glass_sdf(p - vec2(1.5, 0.0));
    float dy = glass_sdf(p + vec2(0.0, 1.5)) - glass_sdf(p - vec2(0.0, 1.5));
    vec2 rim_normal = normalize(vec2(dx, dy) + vec2(1e-6));

    /* Rim parameter: 1 at the silhouette, 0 where the lens flattens out.
     * Band width scales with the body like the rest of the geometry. */
    float edge = max(pc.edge_width * size_scale, 1.0);
    float u = clamp(1.0 + d / edge, 0.0, 1.0);
    /* Convex-lens bend profile: spherical-cap slope u/sqrt(1-u²), clamped
     * where the physical cap would turn vertical, then normalised to 0..1.
     * The interior stays at exactly 0 — no centre distortion. */
    float lens = min(u * inversesqrt(1.0 - u * u + 0.02), 3.0) * (1.0 / 3.0);

    vec2 inv_extent = 1.0 / vec2(pc.width, pc.height);
    vec2 uv = p * inv_extent;
    vec2 normal_uv = rim_normal * inv_extent;

    /* Lensing: sample the sharp backdrop inward along the rim normal —
     * a magnifier, strongest at the silhouette. Dispersion separates the
     * red/blue bend, so fringes live only inside the rim band. Both scale
     * with the body like the rim band. */
    float refraction = pc.refraction * size_scale;
    float chromatic = pc.chromatic_aberration * size_scale;
    float bend_g = refraction * lens;
    float bend_r = (refraction + chromatic) * lens;
    float bend_b = max(refraction - chromatic, 0.0) * lens;
    vec3 refracted;
    refracted.r = sample_image(pc.input_handle, uv - normal_uv * bend_r).r;
    refracted.g = sample_image(pc.input_handle, uv - normal_uv * bend_g).g;
    refracted.b = sample_image(pc.input_handle, uv - normal_uv * bend_b).b;
    vec3 frost = sample_image(pc.blurred_handle, uv - normal_uv * bend_g * 0.5).rgb;

    /* Scatter: mostly clear body; soft scattering grows through the rim.
     * The interior term takes the group's full strength while the rim band
     * keeps the classic profile (capped at 1.0), so a per-group strength
     * raise fogs the body without over-frosting the silhouette, where
     * refraction legibility lives. */
    vec2 strengths = strength_params();
    float tint_strength = strengths.x;
    float frost_strength = strengths.y;
    float frost_amount =
        clamp(0.08 * frost_strength + 0.20 * u * u * min(frost_strength, 1.0), 0.0, 1.0);
    frost_amount *= 1.0 - 0.62 * focus;
    vec3 colour = mix(refracted, frost, frost_amount);
    colour = adjust_saturation(colour, max(pc.saturation, 0.0));

    /* Adaptive body tint, opposing the backdrop: pearl over dark content,
     * smoke over bright. Weakest inside the rim band, where lensing and
     * light already provide separation. The smoke side is strong enough
     * to hold the body apart from uniform white content. A non-negative
     * plate_polarity pins the caller-chosen polarity for the whole body
     * (uniform plate tone); negative keeps the legacy per-pixel polarity
     * from the local blurred sample. */
    vec2 tone = tone_params();
    float plate_polarity = tone.x;
    float backdrop_energy = tone.y;
    float backdrop_luminance = dot(frost, vec3(0.2126, 0.7152, 0.0722));
    float dark_backdrop = plate_polarity >= 0.0
                              ? plate_polarity
                              : 1.0 - smoothstep(0.20, 0.62, backdrop_luminance);
    vec3 tint_rgb = vec3((tint_color() >> 16) & 0xFFu, (tint_color() >> 8) & 0xFFu,
                         tint_color() & 0xFFu) / 255.0;
    vec3 tint_colour = mix(vec3(0.045, 0.05, 0.065), vec3(1.0), dark_backdrop) * tint_rgb;
    float tint_amount = mix(0.24, 0.10, dark_backdrop) * (0.65 + 0.35 * (1.0 - u)) *
                        tint_strength;
    tint_amount *= 1.0 - 0.48 * focus;
    /* Busy backdrops get a stronger tint: the energy boost lifts the body
     * off high-frequency content without changing the quiet-content look. */
    if (backdrop_energy >= 0.0)
        tint_amount *= min(1.0 + 1.5 * backdrop_energy, 2.0);
    colour = mix(colour, tint_colour, tint_amount);
    colour *= max(pc.brightness, 0.0);

    /* Selected content is a focus field inside this body, never another
     * body. It becomes clearer and slightly more chromatic, while a restrained
     * directional gain preserves the scene's own hue. There is deliberately
     * no additive white wash or edge ring to read as a nested material. */
    if (focus > 0.0) {
        vec2 focus_uv = clamp((p - pc.focus_shape.xy) / max(pc.focus_shape.zw, vec2(1.0)), vec2(0.0), vec2(1.0));
        float focus_key = clamp(1.05 - dot(focus_uv, vec2(0.35, 0.65)), 0.0, 1.0);
        float focus_luminance = dot(colour, vec3(0.2126, 0.7152, 0.0722));
        colour = mix(vec3(focus_luminance), colour, 1.0 + 0.08 * focus);
        colour *= 1.0 + 0.018 * focus * (0.40 + 0.60 * focus_key);
    }

    /* Light. key_dir points from the shape toward the key light. The
     * parameter is the light's position direction (default up-left;
     * y runs downward), so light-facing edges have n·key > 0. */
    vec2 key_dir = normalize(light_direction() + vec2(1e-6));
    float facing = max(dot(rim_normal, key_dir), 0.0);
    float away = max(dot(rim_normal, -key_dir), 0.0);

    /* 1) Key line: a ~2 px gaussian hugging the silhouette on the
     * light-facing side. This — not a broad rim wash — is the highlight. */
    float line = exp(-(d + 0.75) * (d + 0.75) / 2.88);
    colour += vec3(1.0) * (pc.rim_light * 1.05 * pow(facing, 1.6) * line);

    /* 2) Soft sheen across the rim band, keyed to the light. */
    colour += vec3(1.0) * (pc.rim_light * 0.10 * facing * facing * u * u);

    /* 3) Fresnel env sheen: direction-modulated, so it brightens the top
     * and dies at the bottom instead of ringing the whole silhouette. */
    float fresnel = u * u * u * u;
    colour += vec3(1.0) * (pc.rim_light * 0.12 * fresnel * (0.15 + 0.85 * facing * facing));

    /* 4) Shadow side: a thin dark line opposite the key light. */
    colour *= 1.0 - 0.22 * pc.rim_light * pow(away, 1.8) * line;

    /* 4b) Edge absorption: grazing light dies at the silhouette in every
     * direction. Stronger over bright content, where the body would
     * otherwise merge with a white backdrop. */
    float absorb = (0.05 + 0.09 * (1.0 - dark_backdrop)) * exp(-(d + 0.5) * (d + 0.5) / 1.62);
    colour *= 1.0 - absorb;

    /* 5) Transmitted-light trough: faint concentration just inside the
     * bottom rim, where light through the lens pools. */
    float trough = away * away * smoothstep(0.25, 0.75, u) * (1.0 - smoothstep(0.85, 1.0, u));
    colour += vec3(1.0) * (0.05 * pc.rim_light * trough);

    /* Sub-LSB dither: smooth studio gradients band visibly in rgba8.
     * 16F outputs keep full float precision instead. */
#ifndef PRISM_STORAGE_RGBA16F
    float dither = fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453) - 0.5;
    colour += dither * (1.5 / 255.0);
#endif

    /* Body alpha, then shadow composited underneath the AA fringe and any
     * semi-transparent body. */
    float alpha = coverage * clamp(pc.opacity, 0.0, 1.0);
    alpha = alpha + shadow * (1.0 - alpha);
    store_source_over(pixel, vec4(colour * alpha, alpha));
}
