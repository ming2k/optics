#version 450

#extension GL_GOOGLE_include_directive : require

#include "flux_sdf.glsl"
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require

/*
 * Analytic liquid-glass compositor — convex-lens model.
 *
 * The body is treated as a thin lens slab: optically flat in the interior
 * (backdrop passes through undistorted) with a curved rim band of
 * `edge_width` px whose slope follows a clamped spherical-cap profile.
 * The same rounded-rectangle SDF drives coverage, the rim parameterisation
 * and the refraction normal, so no layer can disagree at a corner. Two
 * SDFs can be smoothly unioned into one body for liquid/spring merges.
 *
 * Layer stack, evaluated per pixel inside the analytic coverage:
 *   1. LENSING — refraction displaces the sharp backdrop inward along the
 *      rim normal (convex-lens magnification), with per-channel bend for
 *      chromatic dispersion confined to the rim band.
 *   2. SCATTER — a small frost mix, growing slightly through the rim band.
 *   3. ADAPTIVE TINT — opposes backdrop luminance: pearl lift over dark
 *      content, smoke dim over bright content (legibility layer).
 *   4. LIGHT — a thin directional key line hugging the silhouette on the
 *      light-facing side, a soft sheen across the rim, a shadow-side dark
 *      line opposite the key, and a faint transmitted-light trough inside
 *      the bottom rim. Nothing here is a broad additive wash: the rim
 *      reads as sculpted light, not as a white halo.
 */

layout(set = 0, binding = 0) uniform texture2D u_sampled[];
/* Storage qualifier matches the output format (ADR-0069): rgba16f for
 * working-space (16F) inputs, rgba8 otherwise. Compiled twice, see meson. */
#ifdef PRISM_STORAGE_RGBA16F
layout(set = 0, binding = 1, rgba16f) uniform image2D u_storage[];
#else
layout(set = 0, binding = 1, rgba8) uniform image2D u_storage[];
#endif
layout(set = 0, binding = 2) uniform sampler u_samplers[];

layout(push_constant) uniform PC {
    uint input_handle;
    uint blurred_handle;
    uint sampler_handle;
    uint output_handle;
    uint width;          /* output slab extent */
    uint height;
    uint origin_x;       /* this dispatch's region inside the slab */
    uint origin_y;
    uint region_width;
    uint region_height;
    float slab_origin_x; /* this slab's origin in capture space */
    float slab_origin_y;
    float capture_width;
    float capture_height;
    uint bodies_address_lo; /* body table, rows of GlassBody */
    uint bodies_address_hi;
    uint ids_address_lo;    /* this region's body ids, in source-over order */
    uint ids_address_hi;
    uint id_count;
    uint reserved0;
    /* Dispatch-wide optical policy. */
    float refraction;
    float chromatic_aberration;
    float saturation;
    float brightness;
    float edge_width;
    float rim_light;
    float opacity;
    float size_reference;
    float size_scale_min;
    float tint_strength;
    float frost_strength;
    float policy_curvature;
    float contact_ao;
    float ambient_fresnel;
    float light_x;
    float light_y;
} pc;

layout(local_size_x = 16, local_size_y = 16) in;

/* Per-body parameters. One row per caller group, written by the host with every
 * inherit/override and clamp already resolved, so the shader carries no
 * inheritance logic and the push block stays per-dispatch.
 *
 * The table is read through a device address because flux devices do not
 * guarantee shaderInt64; the address arrives as two u32 words. */
layout(buffer_reference, std430) buffer BodyIds {
    uint ids[];
};


struct GlassBody {
    vec4 shape0;
    vec4 shape1;
    vec4 focus_shape;
    float radius0;
    float radius1;
    float focus_radius;
    float blend_radius;
    float opacity;
    float shadow_alpha;
    float shadow_blur;
    float shadow_offset_y;
    float tint_strength;
    float frost_strength;
    float saturation;
    float curvature;
    float contact_ao;
    float ambient_fresnel;
    float size_reference;
    float size_scale_min;
    float light_x;
    float light_y;
    uint tint_color;
    uint shape_count;
    uint has_focus;
    uint reserved;
    /* Pad to PRISM_BODY_STRIDE (256 bytes) so the shader's array stride and the
     * host's row stride are the same number. They are two sides of one contract:
     * the host writes row i at i * 256 and the shader indexes bodies[i] with its
     * own ArrayStride, so a mismatch silently reads the wrong row (or garbage
     * halfway through the second body). 132 payload + 31 words = 256. */
    uint pad0[2]; /* payload 136 -> 144: glslang 16-aligns the struct */
    vec4 pad1[7]; /* 112 more -> 256 = PRISM_BODY_STRIDE */
};

layout(buffer_reference, std430, buffer_reference_align = 16) buffer BodyTable {
    GlassBody bodies[];
};


GlassBody body_at(uint index)
{
    return BodyTable(uvec2(pc.bodies_address_lo, pc.bodies_address_hi)).bodies[index];
}

/* `ids_address` already points at THIS batch's first id: the host offsets the
 * table address by the batch's position, so the shader indexes from 0. */
uint body_id(uint index)
{
    return BodyIds(uvec2(pc.ids_address_lo, pc.ids_address_hi)).ids[index];
}

uvec2 region_extent()
{
    return uvec2(pc.region_width, pc.region_height);
}

vec4 sample_image(uint handle, vec2 uv)
{
    return texture(
        sampler2D(
            u_sampled[nonuniformEXT(handle & 0x0FFFFFFFu)],
            u_samplers[nonuniformEXT(pc.sampler_handle & 0x0FFFFFFFu)]
        ),
        clamp(uv, vec2(0.0), vec2(1.0))
    );
}

/* Bodies in a region composite source-over into one persistent premultiplied
 * output, in id order — which is the caller's group order. Preserve material
 * already written by an earlier body when a later one's translucent shadow or AA
 * fringe reaches it.
 *
 * No barrier is needed between bodies any more: they are one dispatch and their
 * order is this loop. Dispatches are disjoint regions, so they never observe each
 * other's writes either. */
void store_source_over(uvec2 pixel, vec4 source)
{
    vec4 destination = imageLoad(
        u_storage[nonuniformEXT(pc.output_handle & 0x0FFFFFFFu)], ivec2(pixel)
    );
    imageStore(
        u_storage[nonuniformEXT(pc.output_handle & 0x0FFFFFFFu)],
        ivec2(pixel),
        source + destination * (1.0 - source.a)
    );
}

/* Convention adapter over the single squircle definition in flux_sdf.glsl
 * (ADR-0118/INV-SDF-02): `bounds` is (x, y, w, h) and the non-zero
 * half-extent floor keeps a degenerate group finite. The field - the L2/L4
 * corner blend - is defined once, in flux; this file used to restate it. */
vec2 squircle_centre(vec4 bounds)
{
    vec2 half_extent = max(bounds.zw * 0.5, vec2(0.001));
    return bounds.xy + half_extent;
}

vec2 squircle_half(vec4 bounds)
{
    return max(bounds.zw * 0.5, vec2(0.001));
}

float squircle_sdf(vec2 p, vec4 bounds, float requested_radius, float curvature)
{
    return flux_sdf_squircle(p - squircle_centre(bounds), squircle_half(bounds), requested_radius,
                             curvature);
}

/* A fused body is one field: the composition, like the field itself, lives in
 * flux_sdf.glsl (ADR-0148) so it is defined once and pinned by test_sdf_parity. */
float smooth_union(float a, float b, float radius)
{
    float h;
    return flux_smooth_union(vec2(a, b), radius, h);
}

float glass_sdf(vec2 p, GlassBody b)
{
    float cur = b.curvature;
    float d = squircle_sdf(p, b.shape0, b.radius0, cur);
    if (b.shape_count > 1u) {
        d = smooth_union(d, squircle_sdf(p, b.shape1, b.radius1, cur), b.blend_radius);
    }
    return d;
}

/* Shading normal of the body at `p`, from ONE field evaluation per shape
 * (ADR-0148). The previous form evaluated the field four more times per rim
 * pixel over a 1.5 px span and differenced the results: four times the field
 * work, first-order accurate only, and free to disagree with the coverage the
 * same pixel used. `aa` resolves the interior medial-axis crease over one pixel,
 * so a box diagonal and a union seam both shade continuously. */
vec2 glass_normal(vec2 p, GlassBody b, float aa)
{
    float cur = b.curvature;
    vec3 s0 = flux_sdf_squircle_sample(p - squircle_centre(b.shape0), squircle_half(b.shape0),
                                       b.radius0, cur, aa);
    if (b.shape_count <= 1u) return s0.yz;

    vec3 s1 = flux_sdf_squircle_sample(p - squircle_centre(b.shape1), squircle_half(b.shape1),
                                       b.radius1, cur, aa);
    return flux_smooth_union_gradient(s0.yz, s1.yz, vec2(s0.x, s1.x), b.blend_radius);
}

float focus_field(vec2 p, GlassBody b)
{
    if (b.has_focus == 0u) return 0.0;
    float d = squircle_sdf(p, b.focus_shape, b.focus_radius, b.curvature);
    float small_side = min(b.focus_shape.z, b.focus_shape.w);
    float feather = clamp(small_side * 0.28, 14.0, 36.0);
    /* has_focus is 1 only when the host resolved focus_strength > 0, so the
     * strength itself rides opacity-times-focus elsewhere; 1.0 here means "the
     * caller armed it". */
    return 1.0 - smoothstep(-feather, feather, d);
}

vec3 adjust_saturation(vec3 colour, float saturation)
{
    float luminance = dot(colour, vec3(0.2126, 0.7152, 0.0722));
    return mix(vec3(luminance), colour, saturation);
}

void shade_body(uvec2 pixel, vec2 p, vec2 uv, GlassBody b);

void main()
{
    uvec2 local = gl_GlobalInvocationID.xy;
    uvec2 r_extent = region_extent();
    if (local.x >= r_extent.x || local.y >= r_extent.y) return;
    uvec2 pixel = local + uvec2(pc.origin_x, pc.origin_y);
    if (pixel.x >= pc.width || pixel.y >= pc.height) return;

    /* Capture-space position for this output pixel. The slab is sized to the
     * material's footprints, so output coordinate 0 is capture coordinate
     * slab_origin: capture = output + slab_origin. */
    vec2 p = vec2(pixel) + vec2(0.5) + vec2(pc.slab_origin_x, pc.slab_origin_y);
    vec2 capture_extent = vec2(pc.capture_width, pc.capture_height);
    vec2 uv = p / max(capture_extent, vec2(1.0));

    /* Bodies are composited in id order = caller order. */
    for (uint slot = 0u; slot < pc.id_count; ++slot) {
        GlassBody b = body_at(body_id(slot));
        shade_body(pixel, p, uv, b);
    }
}

/* Shade one body at one pixel and composite it into the persistent output.
 * Called per body id in caller order; `uv` is the capture-space UV and `p` the
 * capture-space pixel centre, both computed once per pixel by the caller. */
void shade_body(uvec2 pixel, vec2 p, vec2 uv, GlassBody b)
{
    float d = glass_sdf(p, b);
    float focus = focus_field(p, b);
    /* One physical pixel of analytic antialiasing; coverage is also the
     * body's output alpha, preventing blur from leaking beyond corners. */
    float coverage = 1.0 - smoothstep(-0.75, 0.75, d);

    /* Drop shadow: the same SDF shifted down by the light offset, with a
     * soft falloff. It grounds the body and is what separates the glass
     * from uniform bright content. Fades with the body's opacity. */
    float body_min = min(b.shape0.z, b.shape0.w);
    vec2 size_ref_min = vec2(b.size_reference, b.size_scale_min);
    float size_scale = 1.0;
    if (size_ref_min.x > 0.0) {
        size_scale = clamp(body_min / size_ref_min.x, size_ref_min.y, 1.0);
    }
    
    float shadow_blur = b.shadow_blur;
    float shadow_offset_y = b.shadow_offset_y;
    float shadow = 0.0;
    if (b.shadow_alpha > 0.0) {
        float sd = glass_sdf(p - vec2(0.0, shadow_offset_y), b);
        shadow = (1.0 - smoothstep(0.0, shadow_blur * 2.0, max(sd, 0.0))) * b.shadow_alpha;
    }
    shadow *= clamp(b.opacity, 0.0, 1.0);
    if (coverage <= 0.0) {
        if (shadow <= 0.002) return;
        store_source_over(pixel, vec4(0.0, 0.0, 0.0, shadow));
        return;
    }

    /* Rim parameter: 1 at the silhouette, 0 where the lens flattens out.
     * Band width scales with the body like the rest of the geometry.
     * Clamped so small bodies (e.g. pills/chips) maintain an undistorted flat center. */
    float max_edge = max(body_min * 0.35, 1.0);
    float edge = clamp(pc.edge_width * size_scale, 1.0, max_edge);
    float u = clamp(1.0 + d / edge, 0.0, 1.0);
    /* Convex-lens bend profile: spherical-cap slope u/sqrt(1-u²), clamped
     * where the physical cap would turn vertical, then normalised to 0..1.
     * The interior stays at exactly 0 — no centre distortion. */
    float lens = min(u * inversesqrt(1.0 - u * u + 0.02), 3.0) * (1.0 / 3.0);

    /* Outward rim normal from the SDF gradient, analytically (ADR-0148). It
     * stays gated on the rim band: in the flat interior (u == 0) the lens bend
     * and every rim term are zero, so the normal is never read there. `aa` is
     * one pixel in shape units — the dispatch's shape space is capture pixels —
     * and is consumed only by the interior crease rule. */
    vec2 rim_normal = vec2(0.0, 1.0);
    if (u > 0.0) {
        rim_normal = glass_normal(p, b, 1.0);
    }

    vec2 inv_extent = 1.0 / max(vec2(pc.capture_width, pc.capture_height), vec2(1.0));
    vec2 normal_uv = rim_normal * inv_extent;

    /* Lensing: sample the sharp backdrop inward along the rim normal —
     * a magnifier, strongest at the silhouette. Dispersion separates the
     * red/blue bend, so fringes live only inside the rim band. Both scale
     * with the body like the rim band. In the flat interior (lens == 0),
     * all three channels sample uv directly without chromatic dispersion. */
    float refraction = pc.refraction * size_scale;
    float chromatic = pc.chromatic_aberration * size_scale;
    float bend_g = refraction * lens;
    float bend_r = (refraction + chromatic) * lens;
    float bend_b = max(refraction - chromatic, 0.0) * lens;
    vec3 refracted;
    if (lens > 0.0001) {
        refracted.r = sample_image(pc.input_handle, uv - normal_uv * bend_r).r;
        refracted.g = sample_image(pc.input_handle, uv - normal_uv * bend_g).g;
        refracted.b = sample_image(pc.input_handle, uv - normal_uv * bend_b).b;
    } else {
        refracted = sample_image(pc.input_handle, uv).rgb;
    }
    vec3 frost = sample_image(pc.blurred_handle, uv - normal_uv * bend_g * 0.5).rgb;

    /* Scatter: mostly clear body; soft scattering grows through the rim.
     * The interior term takes the group's full strength while the rim band
     * keeps the classic profile (capped at 1.0), so a per-group strength
     * raise fogs the body without over-frosting the silhouette, where
     * refraction legibility lives. */
    vec2 strengths = vec2(b.tint_strength, b.frost_strength);
    float tint_strength = strengths.x;
    float frost_strength = strengths.y;
    float interior_frost = frost_strength <= 1.0
                               ? 0.08 * frost_strength
                               : clamp(0.08 + (frost_strength - 1.0) * 0.20, 0.0, 1.0);
    float frost_amount =
        clamp(interior_frost + 0.20 * u * u * min(frost_strength, 1.0), 0.0, 1.0);
    frost_amount *= 1.0 - 0.35 * focus;
    vec3 colour = mix(refracted, frost, frost_amount);
    colour = adjust_saturation(colour, max(b.saturation, 0.0));

    /* Physical dielectric optics:
     * 1) Ambient reflectance floor: over dark content, the dielectric surface
     *    reflects an ambient baseline (~10% pearl wash), ensuring floating glass
     *    remains visible over pitch black without disappearing.
     * 2) Volumetric transmission: light passing through the glass experiences
     *    natural optical attenuation (~15-18%) and tint absorption along its optical
     *    thickness, without artificial dirty smoke plate darkening. */
    vec2 optics = vec2(b.contact_ao, b.ambient_fresnel);
    float contact_ao = optics.x;
    float ambient_fresnel = optics.y;

    float backdrop_luma = dot(frost, vec3(0.2126, 0.7152, 0.0722));
    float dark_ratio = 1.0 - smoothstep(0.15, 0.65, backdrop_luma);
    float tint_profile = (0.65 + 0.35 * (1.0 - u)) * tint_strength * (1.0 - 0.25 * focus);

    vec3 tint_rgb = vec3((b.tint_color >> 16) & 0xFFu, (b.tint_color >> 8) & 0xFFu,
                         b.tint_color & 0xFFu) / 255.0;

    // Ambient reflection floor on dark backgrounds (~10% pearl):
    vec3 refl_floor = vec3(1.0) * tint_rgb * (0.10 * dark_ratio * tint_profile);

    // Volumetric transmission through medium (pure glass transmission loss + chromatic tint):
    float trans_atten = mix(0.24, 0.08, dark_ratio) * tint_profile;
    vec3 trans_color = colour * mix(vec3(0.65), tint_rgb, 0.35);
    colour = mix(colour, trans_color, trans_atten) + refl_floor;
    colour *= max(pc.brightness, 0.0);

    /* Selected content is a focus field inside this body, never another
     * body. It becomes clearer and slightly more chromatic, while a restrained
     * directional gain preserves the scene's own hue. There is deliberately
     * no additive white wash or edge ring to read as a nested material. */
    if (focus > 0.0) {
        vec2 focus_uv = clamp((p - b.focus_shape.xy) / max(b.focus_shape.zw, vec2(1.0)), vec2(0.0), vec2(1.0));
        float focus_key = clamp(1.05 - dot(focus_uv, vec2(0.35, 0.65)), 0.0, 1.0);
        float focus_luminance = dot(colour, vec3(0.2126, 0.7152, 0.0722));
        colour = mix(vec3(focus_luminance), colour, 1.0 + 0.08 * focus);
        colour *= 1.0 + 0.018 * focus * (0.40 + 0.60 * focus_key);
    }

    /* Pure physical water droplet / dielectric convex lens model:
     * Screen content passes through the droplet with single-pass optical refraction.
     * Ambient light reflects off the curved meniscus surface as clean specular rims
     * with zero ghosting or duplicate offset imagery. */

    vec2 key_dir = normalize(vec2(b.light_x, b.light_y) + vec2(1e-6));

    /* 3D Meniscus Illumination and Contact AO:
     * Concentrated at the rim band (u > 0). In the flat interior (u == 0,
     * including small bodies where d may still exceed -5.0), specular
     * highlights and contact creases attenuate to 0.0 — and the fallback
     * rim_normal is never read. */
    if (u > 0.0) {
        float top_facing = max(-rim_normal.y, 0.0);
        float key_align = max(dot(rim_normal, key_dir), 0.0);
        /* x^1.25 == x*sqrt(sqrt(x)): exact, one multiply plus two square roots
         * instead of a transcendental. Both bases are clamped at 0. */
        float top_rim = (top_facing * sqrt(sqrt(top_facing))) *
                        (0.65 + 0.35 * (key_align * sqrt(sqrt(key_align))));

        float bot_facing = max(rim_normal.y, 0.0);
        float away_align = max(dot(rim_normal, -key_dir), 0.0);
        float bot_rim = (bot_facing * sqrt(sqrt(bot_facing))) *
                        (0.55 + 0.35 * (away_align * sqrt(sqrt(away_align))));

        float line = exp(-(d + 0.65) * (d + 0.65) / 2.00);
        float tir_line = exp(-(d + 0.80) * (d + 0.80) / 2.00);
        float ambient_rim = (0.28 + 0.32 * max(ambient_fresnel, 0.0)) * line;

        float total_spec = ambient_rim + top_rim * line + bot_rim * tir_line;

        vec3 spec_tint = mix(vec3(1.0), max(frost, vec3(0.12)) * 1.35, 0.28);
        colour += spec_tint * (pc.rim_light * total_spec);

        float contact_alpha = clamp(contact_ao, 0.0, 1.0);
        float contact_absorb = contact_alpha * 0.45 * exp(-d * d / 1.20);
        colour *= 1.0 - contact_absorb;
    }

    /* Sub-LSB dither: smooth studio gradients band visibly in rgba8.
     * 16F outputs keep full float precision instead. */
#ifndef PRISM_STORAGE_RGBA16F
    float dither = fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453) - 0.5;
    colour += dither * (1.5 / 255.0);
#endif

    /* Body alpha, then shadow composited underneath the AA fringe and any
     * semi-transparent body. */
    float alpha = coverage * clamp(b.opacity, 0.0, 1.0);
    alpha = alpha + shadow * (1.0 - alpha);
    store_source_over(pixel, vec4(colour * alpha, alpha));}
