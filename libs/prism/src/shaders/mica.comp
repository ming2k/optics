#version 450
#extension GL_EXT_nonuniform_qualifier : require

/*
 * Mica material shader (Windows 11 Fluent Design inspired).
 *
 * Layers:
 *   1. Screen-anchored desktop wallpaper sampling (with local UV fallback);
 *   2. Luminosity plate balancing (Pearl for light theme, Smoke for dark theme);
 *   3. Color tinting layer with Mica Base and Mica Alt (stronger tint/contrast);
 *   4. Procedural blue-noise grain / triangular dither (eliminates 8-bit banding);
 *   5. Inactive / low-power solid fallback state blending;
 *   6. 1px SDF border highlight rim;
 *   7. Analytic drop shadow.
 */

layout(set = 0, binding = 0) uniform texture2D u_sampled[];
#ifdef PRISM_STORAGE_RGBA16F
layout(set = 0, binding = 1, rgba16f) uniform image2D u_storage[];
#else
layout(set = 0, binding = 1, rgba8) uniform image2D u_storage[];
#endif
layout(set = 0, binding = 2) uniform sampler u_samplers[];

layout(push_constant) uniform PC {
    uint wallpaper_handle;
    uint blurred_handle;
    uint sampler_handle;
    uint output_handle;
    uint width;
    uint height;
    uint origin_x;
    uint origin_y;
    vec4 bounds;
    float corner_radius;
    float opacity;
    float tint_opacity;
    float luminosity_plate;
    float luminosity_opacity;
    float noise_intensity;
    float border_width;
    float border_alpha;
    float shadow_alpha;
    float shadow_blur;
    float shadow_offset_y;
    uint tint_color;
    uint group_width;
    uint group_height;
    float screen_origin_x;
    float screen_origin_y;
    float screen_width;
    float screen_height;
    uint fallback_color;
    float fallback_weight;
    uint is_alt;
} pc;

layout(local_size_x = 16, local_size_y = 16) in;

vec3 unpack_rgb(uint c)
{
    return vec3(
        float((c >> 16u) & 0xFFu) / 255.0,
        float((c >> 8u) & 0xFFu) / 255.0,
        float(c & 0xFFu) / 255.0
    );
}

float prng_dither(vec2 uv)
{
    float n = fract(sin(dot(uv, vec2(12.9898, 78.233))) * 43758.5453);
    return (n - 0.5);
}

vec4 sample_image(uint handle, vec2 uv)
{
    return texture(
        sampler2D(
            u_sampled[nonuniformEXT(handle & 0x0FFFFFFFu)],
            u_samplers[nonuniformEXT(pc.sampler_handle & 0x0FFFFFFFu)]
        ),
        clamp(uv, vec2(0.0), vec2(1.0))
    );
}

void store_source_over(uvec2 pixel, vec4 source)
{
    vec4 destination = imageLoad(
        u_storage[nonuniformEXT(pc.output_handle & 0x0FFFFFFFu)], ivec2(pixel)
    );
    imageStore(
        u_storage[nonuniformEXT(pc.output_handle & 0x0FFFFFFFu)],
        ivec2(pixel),
        source + destination * (1.0 - source.a)
    );
}

float rounded_rect_sdf(vec2 p, vec4 bounds, float requested_radius)
{
    vec2 half_extent = max(bounds.zw * 0.5, vec2(0.001));
    vec2 centre = bounds.xy + half_extent;
    float radius = clamp(requested_radius, 0.0, min(half_extent.x, half_extent.y));
    vec2 q = abs(p - centre) - half_extent + radius;
    return length(max(q, vec2(0.0))) + min(max(q.x, q.y), 0.0) - radius;
}

void main()
{
    uvec2 local = gl_GlobalInvocationID.xy;
    if (local.x >= pc.group_width || local.y >= pc.group_height) return;

    uvec2 pixel = local + uvec2(pc.origin_x, pc.origin_y);
    if (pixel.x >= pc.width || pixel.y >= pc.height) return;

    vec2 p = vec2(pixel) + vec2(0.5);

    // Screen-anchored or local wallpaper UV
    vec2 wallpaper_uv;
    if (pc.screen_width > 0.0 && pc.screen_height > 0.0) {
        vec2 screen_coord = p + vec2(pc.screen_origin_x, pc.screen_origin_y);
        wallpaper_uv = screen_coord / vec2(pc.screen_width, pc.screen_height);
    } else {
        wallpaper_uv = p / vec2(float(pc.width), float(pc.height));
    }

    float d = rounded_rect_sdf(p, pc.bounds, pc.corner_radius);

    // Drop shadow computation: solid inside shadow footprint (sd <= 0), Gaussian falloff outside (sd > 0)
    float shadow_cov = 0.0;
    if (pc.shadow_alpha > 0.001 && pc.shadow_blur > 0.0) {
        vec2 sp = p - vec2(0.0, pc.shadow_offset_y);
        float sd = rounded_rect_sdf(sp, pc.bounds, pc.corner_radius);
        float sigma = max(pc.shadow_blur * 0.5, 0.5);
        shadow_cov = pc.shadow_alpha * (sd <= 0.0 ? 1.0 : exp(-0.5 * (sd * sd) / (sigma * sigma)));
    }

    if (d > 1.5 && shadow_cov <= 0.001) return;

    // Body coverage
    float body_cov = clamp(0.5 - d, 0.0, 1.0) * pc.opacity;

    // Sample wallpaper (prefer blurred wallpaper, fall back to sharp)
    uint sample_handle = (pc.blurred_handle != 0u && pc.blurred_handle != 0xFFFFFFFFu)
                             ? pc.blurred_handle
                             : pc.wallpaper_handle;
    vec4 sampled_wp = sample_image(sample_handle, wallpaper_uv);

    // Luminosity plate balancing
    // Plate polarity: 0 = smoke (dark mode), 1 = pearl (light mode)
    vec3 smoke_col = (pc.is_alt != 0u) ? vec3(0.08) : vec3(0.12);
    vec3 pearl_col = (pc.is_alt != 0u) ? vec3(0.92) : vec3(0.95);
    vec3 plate_color = mix(smoke_col, pearl_col, clamp(pc.luminosity_plate, 0.0, 1.0));

    float lum_weight = clamp(pc.luminosity_opacity, 0.0, 1.0);
    vec3 plate_blended = mix(sampled_wp.rgb, plate_color, lum_weight);

    // Tint layer
    vec3 tint = unpack_rgb(pc.tint_color);
    float tint_weight = clamp(pc.tint_opacity, 0.0, 1.0);
    if (pc.is_alt != 0u) {
        tint_weight = min(tint_weight * 1.35, 1.0);
    }
    vec3 tinted = mix(plate_blended, tint, tint_weight);

    // Inactive fallback blend
    if (pc.fallback_weight > 0.001) {
        vec3 fallback_rgb = unpack_rgb(pc.fallback_color);
        tinted = mix(tinted, fallback_rgb, clamp(pc.fallback_weight, 0.0, 1.0));
    }

    // 1px subtle SDF border highlight rim / contact crease
    if (pc.border_alpha > 0.001 && pc.border_width > 0.0) {
        float edge_dist = abs(d);
        float border_intensity = clamp(1.0 - edge_dist / max(pc.border_width, 0.5), 0.0, 1.0);
        vec3 rim_col = mix(vec3(1.0), vec3(0.12, 0.15, 0.20), clamp(pc.luminosity_plate, 0.0, 1.0));
        tinted = mix(tinted, rim_col, border_intensity * pc.border_alpha);
    }

    // Procedural noise dither
    float grain = prng_dither(vec2(pixel)) * pc.noise_intensity;
    vec3 body_rgb = clamp(tinted + vec3(grain), 0.0, 1.0);

    // Combine body and drop shadow
    vec4 body_out = vec4(body_rgb * body_cov, body_cov);
    vec4 shadow_out = vec4(vec3(0.0), shadow_cov * (1.0 - body_cov));

    vec4 final_color = body_out + shadow_out;
    if (final_color.a > 0.001) {
        store_source_over(pixel, final_color);
    }
}
