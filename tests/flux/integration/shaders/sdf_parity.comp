/*
 * sdf_parity.comp — differential harness for the SDF derivative (ADR-0148).
 *
 * This shader exists for one reason: to evaluate the *real*
 * `flux_sdf.glsl` on the GPU and write its distance and normal into a storage
 * buffer, so a test can compare them against `<flux/sdf.h>` on the CPU.
 *
 * Both sides include the same header. If either drifts — a different
 * expression, a different edge rule, a different normal convention — the
 * comparison fails. That is the mechanical enforcement `[INV-SDF-02]` claims,
 * replacing a hand-transcribed reference that could not detect shader drift at
 * all.
 *
 * Output layout: one vec4 per sample, `(distance, normal.x, normal.y, 0)`.
 */
#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_buffer_reference : require
#extension GL_GOOGLE_include_directive : require

#include "flux_sdf.glsl"

layout(local_size_x = 64) in;

/* Each sample carries its own geometry, so one dispatch covers a sweep of
 * extents, radii, and curvatures rather than a single shape. */
struct Params {
    uint64_t out_address;
    vec2 half_extent;
    float radius;
    float curvature;
    float aa;
    uint sample_count;
    /* 0 = flux_sdf_squircle_sample (shading normal), 1 = the continuum
     * gradient. Both are public surface in both languages, so both are
     * pinned here rather than leaving one unverified. */
    uint mode;
    float pad1;
    float pad2;
};

layout(push_constant) uniform Push {
    Params p;
} pc;

layout(buffer_reference, std430, buffer_reference_align = 16) buffer OutBuf {
    vec4 samples[];
};

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.p.sample_count) return;

    /* Deterministic lattice that covers the interior, the boundary rim, and
     * far exterior, with a non-axis-aligned stride so the box diagonal (the
     * interior medial-axis crease) is sampled too. */
    uint cols = uint(ceil(sqrt(float(pc.p.sample_count))));
    uint rows = (pc.p.sample_count + cols - 1u) / cols;
    float u = (rows <= 1u) ? 0.5 : (float(i / cols) / float(rows - 1u));
    float v = (cols <= 1u) ? 0.5 : (float(i % cols) / float(cols - 1u));

    vec2 half_extent = pc.p.half_extent;
    float extent = max(half_extent.x, half_extent.y);
    /* Frame the shape with margin so both interior and exterior are covered. */
    vec2 p = (vec2(v, u) * 2.0 - 1.0) * extent * 2.2;

    vec3 s;
    if (pc.p.mode == 2u) {
        /* A fused body: two fields, one composition. `radius` is the blend, and
         * the second shape is offset by half the first extent so the union seam
         * actually exists in the sampled window. */
        vec2 p_b = p - vec2(half_extent.x * 0.75, 0.0);
        vec3 a = flux_sdf_squircle_sample(p, half_extent, pc.p.radius * 0.25, pc.p.curvature,
                                          pc.p.aa);
        vec3 b_ = flux_sdf_squircle_sample(p_b, half_extent * 0.7, pc.p.radius * 0.25,
                                           pc.p.curvature, pc.p.aa);
        float h;
        float d = flux_smooth_union(vec2(a.x, b_.x), pc.p.radius, h);
        vec2 g = flux_smooth_union_gradient(a.yz, b_.yz, vec2(a.x, b_.x), pc.p.radius);
        s = vec3(d, g.x, g.y);
    } else if (pc.p.mode == 1u) {
        float d = flux_sdf_squircle(p, half_extent, pc.p.radius, pc.p.curvature);
        vec2 g = flux_sdf_squircle_gradient(p, half_extent, pc.p.radius, pc.p.curvature);
        s = vec3(d, g.x, g.y);
    } else {
        s = flux_sdf_squircle_sample(p, half_extent, pc.p.radius, pc.p.curvature, pc.p.aa);
    }
    OutBuf dst = OutBuf(pc.p.out_address);
    dst.samples[i] = vec4(s.x, s.y, s.z, 0.0);
}
